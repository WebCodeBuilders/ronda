# ── Obligatorias ─────────────────────────────────────────────
# Base de datos. Con Docker Compose se arma sola a partir de DB_PASSWORD.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ronda"
DB_PASSWORD="cambiame"
# Clave para firmar las sesiones: 32 caracteres o más. Generala con:
#   openssl rand -base64 48
SESSION_SECRET=""

# ── Opcionales ───────────────────────────────────────────────
# Dirección pública para los QR de las mesas (si el local tiene dominio).
# PUBLIC_URL="https://carta.miparador.com.ar"
# Cookies solo por HTTPS. Vacío = automático (se activa si se entra por https).
# COOKIE_SECURE="true"
# Puerto donde escucha (Docker Compose).
# PORT=3000
