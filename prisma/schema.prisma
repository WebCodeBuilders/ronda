// ronda — modelo de datos.
//
// Multi-comercio desde el día uno: TODA tabla de negocio cuelga de
// `organizationId`, así la misma base sirve para un local con su servidor
// propio o para la nube con muchos comercios.
//
// Las listas que varían por comercio (medios de pago, sectores, estaciones,
// motivos) son FILAS, nunca enums cableados.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Rubro: restaurant, bar, parador, cafeteria, pizzeria, heladeria, foodtruck, hamburgueseria…
  // Ajusta plantillas y textos por defecto; no cambia el flujo.
  kind      String   @default("restaurant")
  address   String?
  phone     String?
  taxId     String?
  logoUrl   String?
  // Configuración operativa
  serviceChargePerGuest Float   @default(0) // cubierto por persona
  suggestedTipPct       Float   @default(10)
  requireTableForDineIn Boolean @default(true)
  qrOrderingEnabled     Boolean @default(true)
  // Pedido por QR: si lo aprueba un mozo antes de ir a cocina.
  qrOrderNeedsApproval  Boolean @default(true)
  // Minutos a partir de los cuales una comanda se marca demorada.
  kitchenLateMinutes    Int     @default(15)
  // Pide motivo y PIN de encargado para anular algo ya marchado.
  voidNeedsManager      Boolean @default(true)
  ticketFooter          String? @default("Gracias por su visita")
  // Impresora de la caja (precuentas, recibos, cierres). Sin host: se imprime desde el navegador.
  receiptPrinterHost    String?
  receiptPrinterPort    Int     @default(9100)
  receiptPrinterWidth   Int     @default(42)
  // Puntos de fidelidad: 1 punto cada tantos pesos (0 = desactivado).
  pesosPerPoint         Float   @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  devices         Device[]
  areas           Area[]
  tables          DiningTable[]
  stations        Station[]
  categories      Category[]
  products        Product[]
  modifierGroups  ModifierGroup[]
  ingredients     Ingredient[]
  customers       Customer[]
  orders          Order[]
  kitchenTickets  KitchenTicket[]
  printJobs       PrintJob[]
  paymentMethods  PaymentMethod[]
  cashSessions    CashSession[]
  reservations    Reservation[]
  serviceRequests ServiceRequest[]
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  counters        Counter[]
}

// Correlativos por comercio (pedido, comanda). Se incrementan en la misma
// transacción que crea la fila, así nunca se repiten.
model Counter {
  organizationId String
  key            String
  value          Int    @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
}

// ─── Personas y equipos ────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?  @unique
  passwordHash   String?
  // PIN de 4 dígitos para entrar rápido en las terminales compartidas.
  pinHash        String?
  // OWNER, MANAGER, CASHIER, WAITER, KITCHEN, DELIVERY — los permisos salen de lib/permissions.ts
  role           String   @default("WAITER")
  color          String   @default("accent")
  active         Boolean  @default(true)
  // Corta las sesiones emitidas antes de esta fecha (cambio de PIN/contraseña, baja).
  sessionsValidFrom DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ordersAsWaiter Order[]      @relation("OrderWaiter")
  ordersDelivered Order[]     @relation("OrderCourier")
  payments       Payment[]
  cashSessionsOpened CashSession[] @relation("CashOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashClosedBy")
  cashMovements  CashMovement[]
  auditLogs      AuditLog[]

  @@index([organizationId])
}

// Una computadora, tablet o celular vinculado al local. La terminal sabe qué
// es (caja, mozo, cocina, pantalla) y a qué estación mira, sin que nadie tenga
// que configurarla cada mañana.
model Device {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  // POS (caja principal), WAITER (mozo), KDS (pantalla de cocina/barra), DISPLAY (pantalla de retiro)
  kind           String    @default("WAITER")
  stationId      String?
  tokenHash      String?   @unique
  pairingCode    String?   @unique
  pairingExpires DateTime?
  lastSeenAt     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  station      Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// ─── Salón ─────────────────────────────────────────────────────────────

// Sector del salón: Salón, Terraza, Barra, Playa, Deck…
model Area {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  sort           Int     @default(0)
  // Tamaño lógico del plano (unidades de grilla).
  width          Int     @default(1000)
  height         Int     @default(640)
  active         Boolean @default(true)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tables       DiningTable[]

  @@index([organizationId])
}

model DiningTable {
  id             String  @id @default(cuid())
  organizationId String
  areaId         String
  name           String
  seats          Int     @default(4)
  // SQUARE, ROUND, RECT, BAR (banqueta), UMBRELLA (sombrilla), LOUNGER (reposera), BOOTH
  shape          String  @default("SQUARE")
  x              Float   @default(40)
  y              Float   @default(40)
  w              Float   @default(90)
  h              Float   @default(90)
  rotation       Float   @default(0)
  // Token del QR de la mesa (carta digital, llamar al mozo, pedir la cuenta).
  qrToken        String  @unique @default(cuid())
  active         Boolean @default(true)
  // Mesa unida a otra (las mesas juntadas se cobran en la principal).
  mergedIntoId   String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area         Area             @relation(fields: [areaId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]
  requests     ServiceRequest[]

  @@index([organizationId])
  @@index([areaId])
}

// ─── Carta ─────────────────────────────────────────────────────────────

// Estación de producción: Cocina, Parrilla, Barra, Cafetería, Postres.
// Cada una puede tener pantalla (KDS), impresora térmica, o las dos.
model Station {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  color          String  @default("accent")
  sort           Int     @default(0)
  kdsEnabled     Boolean @default(true)
  printerEnabled Boolean @default(false)
  // Impresora térmica en red (ESC/POS por TCP, puerto 9100 por defecto).
  printerHost    String?
  printerPort    Int     @default(9100)
  printerWidth   Int     @default(42) // caracteres por renglón (80mm ≈ 42/48, 58mm ≈ 32)
  printerCopies  Int     @default(1)
  active         Boolean @default(true)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   Category[]
  products     Product[]
  tickets      KitchenTicket[]
  printJobs    PrintJob[]
  devices      Device[]
  orderItems   OrderItem[]

  @@index([organizationId])
}

model Category {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  color          String  @default("accent")
  sort           Int     @default(0)
  // Estación por defecto de todo lo que está en esta categoría.
  stationId      String?
  active         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  station      Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  products     Product[]

  @@index([organizationId])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  // Si está, le gana a la estación de la categoría.
  stationId      String?
  name           String
  shortName      String?  // lo que sale en la comanda ("Mila napo c/fritas")
  description    String?
  price          Float
  cost           Float    @default(0)
  imageUrl       String?
  sku            String?
  // Paso sugerido: 1 entradas, 2 principales, 3 postres, 0 = sale apenas se marcha (bebidas).
  course         Int      @default(2)
  prepMinutes    Int      @default(10)
  // false = "86": se terminó por hoy. Se apaga en todas las terminales y en la carta QR al instante.
  available      Boolean  @default(true)
  showInQrMenu   Boolean  @default(true)
  // Producto que no pasa por cocina (agua, gaseosa en lata): se marca entregado al marchar.
  skipKitchen    Boolean  @default(false)
  // Precio libre (se carga al vender: "varios", pesca del día).
  openPrice      Boolean  @default(false)
  tags           String[] @default([])
  sort           Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  station        Station?               @relation(fields: [stationId], references: [id], onDelete: SetNull)
  modifierGroups ProductModifierGroup[]
  recipe         RecipeItem[]
  orderItems     OrderItem[]

  @@index([organizationId])
  @@index([categoryId])
}

// "Punto de la carne", "Guarnición", "Extras", "Sin…"
model ModifierGroup {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  minSelect      Int     @default(0)
  maxSelect      Int     @default(1)
  sort           Int     @default(0)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  options      Modifier[]
  products     ProductModifierGroup[]

  @@index([organizationId])
}

model Modifier {
  id         String  @id @default(cuid())
  groupId    String
  name       String
  priceDelta Float   @default(0)
  sort       Int     @default(0)
  available  Boolean @default(true)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model ProductModifierGroup {
  productId String
  groupId   String
  sort      Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

// ─── Insumos y recetas ─────────────────────────────────────────────────

model Ingredient {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  unit           String  @default("u") // u, kg, g, l, ml
  stock          Float   @default(0)
  minStock       Float   @default(0)
  cost           Float   @default(0) // por unidad
  active         Boolean @default(true)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeItems  RecipeItem[]
  movements    StockMovement[]

  @@index([organizationId])
}

model RecipeItem {
  id           String @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Float

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

model StockMovement {
  id             String   @id @default(cuid())
  organizationId String
  ingredientId   String
  // SALE (consumo por venta), PURCHASE, ADJUST, WASTE (merma), RETURN (anulación)
  kind           String
  quantity       Float    // con signo
  orderId        String?
  note           String?
  userId         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ─── Clientes ──────────────────────────────────────────────────────────

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  addressNotes   String?
  birthday       DateTime?
  notes          String?   // alergias, preferencias, mesa favorita
  tags           String[]  @default([])
  points         Int       @default(0)
  // Cuenta corriente: positivo = nos debe.
  balance        Float     @default(0)
  creditLimit    Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]
  payments     Payment[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

// ─── Pedidos ───────────────────────────────────────────────────────────

model Order {
  id             String    @id @default(cuid())
  organizationId String
  number         Int
  // DINE_IN (mesa), COUNTER (mostrador), TAKEAWAY (para llevar), DELIVERY, QR (autoservicio desde la mesa)
  type           String    @default("DINE_IN")
  // OPEN, BILLING (pidió la cuenta / precuenta impresa), PAID, CANCELLED
  status         String    @default("OPEN")
  // Circuito de entrega para llevar/delivery: PENDING, PREPARING, READY, ON_THE_WAY, DELIVERED
  fulfillment    String?
  source         String    @default("STAFF") // STAFF, QR, PHONE, WEB
  tableId        String?
  waiterId       String?
  customerId     String?
  courierId      String?
  guests         Int       @default(1)
  customerName   String?   // nombre para llamar en el mostrador / para llevar
  customerPhone  String?
  deliveryAddress String?
  deliveryFee    Float     @default(0)
  scheduledFor   DateTime?
  notes          String?
  // Importes. Los renglones guardan el precio final; acá queda el resumen.
  subtotal       Float     @default(0)
  discountPct    Float     @default(0)
  discountAmount Float     @default(0)
  discountReason String?
  serviceCharge  Float     @default(0)
  tip            Float     @default(0)
  total          Float     @default(0)
  paidAmount     Float     @default(0)
  billPrintedAt  DateTime?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  cancelReason   String?
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table        DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiter       User?           @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  courier      User?           @relation("OrderCourier", fields: [courierId], references: [id], onDelete: SetNull)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  tickets      KitchenTicket[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, openedAt])
  @@index([tableId])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  productId   String?
  stationId   String?
  ticketId    String?
  name        String
  unitPrice   Float     // precio final por unidad, modificadores incluidos
  quantity    Float     @default(1)
  total       Float
  // [{ groupName, name, priceDelta }]
  modifiers   Json      @default("[]")
  notes       String?
  course      Int       @default(2)
  seat        Int?      // comensal (para dividir la cuenta por persona)
  // DRAFT (cargado, sin marchar), HOLD (marchado pero esperando el "¡marchá!" del paso),
  // SENT (en cocina), PREPARING, READY, SERVED, VOID
  status      String    @default("DRAFT")
  sentAt      DateTime?
  startedAt   DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  voidedAt    DateTime?
  voidReason  String?
  voidedById  String?
  // Parte de la cuenta ya cobrada (división por ítems).
  paidQty     Float     @default(0)
  createdById String?
  createdAt   DateTime  @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  station Station?       @relation(fields: [stationId], references: [id], onDelete: SetNull)
  ticket  KitchenTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([ticketId])
}

// La comanda: lo que una estación recibe de una vez para un pedido.
model KitchenTicket {
  id             String    @id @default(cuid())
  organizationId String
  orderId        String
  stationId      String
  number         Int
  // NEW, PREPARING, READY, DONE (retirado / entregado), VOID
  status         String    @default("NEW")
  priority       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  readyAt        DateTime?
  doneAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station      Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([organizationId, status])
  @@index([stationId, status])
}

// Cola de impresión con reintentos. Nada se "pierde" si la impresora está
// apagada: queda pendiente, se reintenta y la caja ve el aviso.
model PrintJob {
  id             String    @id @default(cuid())
  organizationId String
  stationId      String?
  // COMANDA, PRECUENTA, RECIBO, CIERRE_CAJA, ANULACION
  kind           String
  title          String
  // Texto ya formateado al ancho de la impresora.
  content        String
  host           String?
  port           Int?
  // PENDING, PRINTED, FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  printedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  station      Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// ─── Cobros y caja ─────────────────────────────────────────────────────

model PaymentMethod {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  // CASH, CARD, TRANSFER, QR, ACCOUNT (cuenta corriente), OTHER
  kind           String  @default("OTHER")
  // Recargo (+) o descuento (−) en %, por ejemplo tarjeta de crédito.
  adjustPct      Float   @default(0)
  sort           Int     @default(0)
  active         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String?
  customerId    String?
  methodId      String
  cashSessionId String?
  // Lo que entra (con signo: negativo = devolución)
  amount        Float
  tip           Float    @default(0)
  // Recargo del medio de pago (tarjeta en cuotas, etc.). No cubre la cuenta: es aparte.
  surcharge     Float    @default(0)
  // Vuelto entregado (solo efectivo)
  change        Float    @default(0)
  reference     String?
  createdById   String?
  createdAt     DateTime @default(now())

  order       Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  method      PaymentMethod @relation(fields: [methodId], references: [id])
  cashSession CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([cashSessionId])
}

model CashSession {
  id             String    @id @default(cuid())
  organizationId String
  openedById     String
  closedById     String?
  openingAmount  Float     @default(0)
  // Efectivo esperado y contado al cerrar.
  expectedCash   Float?
  countedCash    Float?
  difference     Float?
  notes          String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedBy     User           @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy     User?          @relation("CashClosedBy", fields: [closedById], references: [id])
  payments     Payment[]
  movements    CashMovement[]

  @@index([organizationId, closedAt])
}

model CashMovement {
  id            String   @id @default(cuid())
  cashSessionId String
  // IN (ingreso), OUT (retiro / pago a proveedor)
  kind          String
  amount        Float
  reason        String
  userId        String?
  createdAt     DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Reservas, lista de espera y llamados ──────────────────────────────

model Reservation {
  id             String    @id @default(cuid())
  organizationId String
  // RESERVATION o WAITLIST
  kind           String    @default("RESERVATION")
  customerId     String?
  name           String
  phone          String?
  partySize      Int       @default(2)
  dateTime       DateTime
  durationMin    Int       @default(90)
  tableId        String?
  areaPreference String?
  // PENDING, CONFIRMED, SEATED, NO_SHOW, CANCELLED, DONE
  status         String    @default("CONFIRMED")
  quotedMinutes  Int?
  notes          String?
  createdAt      DateTime  @default(now())
  seatedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table        DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([organizationId, dateTime])
}

// Lo que la mesa pide desde el QR: llamar al mozo, la cuenta, un pedido.
model ServiceRequest {
  id             String    @id @default(cuid())
  organizationId String
  tableId        String
  // CALL_WAITER, BILL, ORDER
  kind           String
  // Para BILL: cómo quiere pagar. Para ORDER: id del pedido.
  detail         String?
  orderId        String?
  // OPEN, ACK (alguien lo tomó), DONE
  status         String    @default("OPEN")
  ackById        String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table        DiningTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// Historial de lo sensible: anulaciones, descuentos, reaperturas, caja.
// Es lo que el dueño mira cuando "no cierra la caja".
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String?
  entityId       String?
  summary        String
  amount         Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
